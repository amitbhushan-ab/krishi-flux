{
  "name": "krishiflux",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "AI-powered water-energy co-optimization platform for Indian smallholder farmers",
  "scripts": {
    "dev": "vite",
    "api": "tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:engine": "esbuild scripts/selftest.ts --bundle --platform=node --format=esm --outfile=scripts/.selftest.mjs --log-level=warning && node scripts/.selftest.mjs",
    "test:api": "tsx scripts/apitest.ts"
  },
  "dependencies": {
    "express": "^5.2.1",
    "lucide-react": "^0.441.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "recharts": "^2.12.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.5.4",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.45",
    "tailwindcss": "^3.4.10",
    "tsx": "^4.23.15",
    "typescript": "^5.5.4",
    "vite": "^5.4.3"
  }
}
